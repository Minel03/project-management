# Copy to .env and adjust for your environment.

PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_management
JWT_SECRET=change-me-in-production
ENABLE_DB_INIT=true

# Managed MySQL (e.g. Aiven) — uncomment and set as needed:
# DB_SSL=true

# Production — example:
# ENABLE_DB_INIT=false
